# Скопируйте в файл .env и заполните
PORT=3000
# Только для своего компьютера: снаружи сайт открывается через nginx (установщик ставит это сам)
HOST=127.0.0.1
# Адрес сайта — нужен для возврата покупателя после оплаты
PUBLIC_URL=https://albakov.ru
# Пароль для первого входа в панель управления (#/admin). Потом смените в «Настройках».
ADMIN_PASSWORD=придумайте-надёжный-пароль
# Ключи ЮKassa можно указать здесь или в панели управления (раздел «Оплата, касса, доставка»)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Почта для писем «Снова в наличии» (можно задать и в панели управления)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Куда отвечают покупатели (если письма уходят с no-reply@)
SMTP_REPLY_TO=
